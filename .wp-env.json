{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "WordPress/WordPress#7.1.3",
  "phpVersion": "8.5",
  "plugins": ["https://downloads.wordpress.org/plugin/woocommerce.zip"],
  "themes": [],
  "mappings": {
    "wp-content/themes/pixonaut-shop": "."
  },
  "port": 8851,
  "testsPort": 8852,
  "lifecycleScripts": {
    "afterStart": "scripts/docker/wp-env-after-start.sh"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true
  },
  "env": {
    "tests": {
      "mappings": {
        "wp-content/mu-plugins/fake-pixonaut.php": "./tests/e2e/fake-pixonaut.php",
        "wp-content/mu-plugins/github-offline.php": "./tests/e2e/github-offline.php",
        "wp-content/mu-plugins/mega-menu.php": "./tests/e2e/mega-menu.php"
      }
    }
  }
}
