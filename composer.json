{
  "name": "pixonaut-app/pixonaut-shop",
  "description": "WooCommerce block theme for stores that sell personalised products through Pixonaut for WooCommerce",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "brain/monkey": "^2.7",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "php-stubs/woocommerce-stubs": "^11.2",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "squizlabs/php_codesniffer": "^3.13.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": { "Pixonaut\\Shop\\": "inc/" }
  },
  "autoload-dev": {
    "psr-4": {
      "Pixonaut\\Shop\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
