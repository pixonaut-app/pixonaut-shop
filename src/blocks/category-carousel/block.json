{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pixonaut-shop/category-carousel",
	"title": "Category carousel",
	"category": "woocommerce",
	"description": "A scrolling row of round category pictures with their names: the subcategories of one product category, or the top-level categories.",
	"keywords": [ "categories", "slider", "scroll" ],
	"textdomain": "pixonaut-shop",
	"attributes": {
		"parent": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.tsx",
	"viewScript": "file:./view.ts",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
